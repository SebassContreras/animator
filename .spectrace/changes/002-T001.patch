--- /dev/null
+++ b/lib/palette.cjs
@@ -0,0 +1,17 @@
+// Palette check: every role maps to { base, shadow?, highlight? } with #RRGGBB values.
+// Pure: generators pass require("./palette.json") and get the same object back, or an Error naming the bad role.
+const HEX = /^#[0-9A-Fa-f]{6}$/;
+const TONES = ["base", "shadow", "highlight"];
+
+const checkPalette = (palette) => {
+  for (const [role, tones] of Object.entries(palette)) {
+    if (typeof tones !== "object" || tones === null || !HEX.test(tones.base)) throw new Error(`palette role "${role}" needs a #RRGGBB base`);
+    for (const key of Object.keys(tones)) {
+      if (!TONES.includes(key)) throw new Error(`palette role "${role}" has unknown tone "${key}"`);
+      if (!HEX.test(tones[key])) throw new Error(`palette role "${role}" has a bad ${key}: ${tones[key]}`);
+    }
+  }
+  return palette;
+};
+
+module.exports = { checkPalette };
