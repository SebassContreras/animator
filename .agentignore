# .agentignore
# Patterns and files excluded from AI agent context indexing and scanning

# Secrets and environment configurations
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*credentials*
*secret*

# Dependencies
node_modules/
vendor/
.pnpm-store/

# Build artifacts and compiled outputs
dist/
build/
out/
.cache/

# Videos compiled scene outputs (when large)
videos/*/scene.json

# Test and coverage artifacts
coverage/
.nyc_output/

# Logs, diagnostics, and local state
*.log
logs/

# Operating system and editor temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
